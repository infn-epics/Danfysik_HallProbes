record(ai, "$(P)$(R)field")
{
    field(DESC, "Hall probe field")
    field(DTYP, "stream")
    field(INP,  "@hallprobe.proto readField $(PORT)")
    field(SCAN, "I/O Intr")
    field(EGU,  "Gauss")
    field(PREC, "6")
}

record(calc, "$(P)$(R)statusCalc")
{
    field(DESC, "Hall probe status calculation")
    field(INPA, "$(P)$(R)field.SEVR CP")
    field(CALC, "A==0?0:1")
}

record(bi, "$(P)$(R)status")
{
    field(DESC, "Hall probe communication status")
    field(INP,  "$(P)$(R)statusCalc CP")
    field(ZNAM, "OK")
    field(ONAM, "ERROR")
}